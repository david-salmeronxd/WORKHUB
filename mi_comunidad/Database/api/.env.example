# Variables de entorno del proyecto
# Copia este archivo a .env y ajusta los valores segun tu entorno.

# Puerto donde escucha la API
PORT=3000

# Cadena de conexion a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://workhub:workhub_dev_password@localhost:5432/workhub

# Nivel de log (info, warn, error, debug)
LOG_LEVEL=info

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Origen permitido de Firebase Hosting. En desarrollo puede ser *.
CORS_ORIGIN=http://localhost:5000
